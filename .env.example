# ─────────────────────────────────────────────────────────────────────────────
# Local-sidecar topology: every service below runs on this Mac.
# Copy to `.env` and fill in the Google OAuth values. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres. Homebrew's postgresql@18 creates a superuser matching your macOS
# username with `trust` auth on localhost, so no password is needed locally.
#
# Zero needs THREE connection strings. In production these can be separate
# databases; locally they all point at the same one:
#   UPSTREAM — the database Zero replicates FROM. Must be a direct connection
#              (never through pgbouncer) and must have wal_level=logical.
#   CVR      — Client View Records: which rows zero-cache has sent to which
#              client, so it can compute minimal diffs on reconnect.
#   CHANGE   — a short buffer of recent replication log entries.
ZERO_UPSTREAM_DB="postgres://USERNAME@localhost:5432/mailapp"
ZERO_CVR_DB="postgres://USERNAME@localhost:5432/mailapp"
ZERO_CHANGE_DB="postgres://USERNAME@localhost:5432/mailapp"

# zero-cache's SQLite replica of Postgres. This is what ZQL queries actually
# run against — it's why reads are fast. Keep it on the internal SSD.
ZERO_REPLICA_FILE="./.data/zero-replica.db"

# The two endpoints zero-cache calls back into on our sidecar. Clients never
# send raw ZQL; they send a query NAME, and /api/query resolves it to
# authoritative ZQL server-side. This is the basis of Zero's permission model.
ZERO_QUERY_URL="http://localhost:3000/api/query"
ZERO_MUTATE_URL="http://localhost:3000/api/mutate"

# Disable Zero's legacy direct-CRUD path — we want every write to go through a
# named mutator so the IMAP/Gmail outbox row is always written in the same
# transaction as the state change.
ZERO_ENABLE_CRUD_MUTATIONS="false"

# Guards zero-cache's /statz and inspector endpoints.
ZERO_ADMIN_PASSWORD="change-me-locally"

# ─────────────────────────────────────────────────────────────────────────────
# Gmail API (Phase 3). Create an OAuth 2.0 Client ID of type "Desktop app" at
# https://console.cloud.google.com/apis/credentials
#
# The client secret in a desktop app is NOT a secret — it ships inside every
# copy of the binary. Google knows this; desktop clients are "public clients"
# and security comes from PKCE + the system browser, not from this value.
# The refresh token IS a real secret and belongs in the macOS Keychain.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
