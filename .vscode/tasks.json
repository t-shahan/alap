{
  // ───────────────────────────────────────────────────────────────────────────
  // These mirror the commands in README.md / docs/COMMANDS.md exactly, so the
  // editor and the terminal can never build the project two different ways.
  //
  // Not listed here: "swift: Build Debug Alap (app)" and friends, which
  // launch.json references. The Swift extension contributes those itself once
  // it discovers app/Package.swift (see swift.searchSubfoldersForPackages in
  // settings.json) — declaring them again would only create duplicates.
  // ───────────────────────────────────────────────────────────────────────────
  "version": "2.0.0",
  "tasks": [
    {
      // Configure step. Also the task that REGENERATES compile_commands.json —
      // run this after adding a source file or changing CMakeLists.txt, or the
      // editor will keep using a stale picture of the build.
      "label": "cmake: configure engine",
      "type": "shell",
      "command": "cmake -S engine -B engine/build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "cmake: build engine",
      "type": "shell",
      "command": "cmake --build engine/build -j8",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      // Parses Clang's "file:line:col: error: message" output into clickable
      // entries in the Problems panel.
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "ctest: engine tests",
      "type": "shell",
      "command": "ctest --test-dir engine/build --output-on-failure",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      // The full .app: SwiftPM build + web assets + embedded engine + signing.
      // "swift: Build Debug Alap (app)" only produces a bare executable, which
      // is not the thing you can actually launch.
      "label": "app: build bundle",
      "type": "shell",
      "command": "./scripts/build-app.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "app: build and run",
      "type": "shell",
      "command": "./scripts/run-app.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "swift: test app",
      "type": "shell",
      "command": "swift test --package-path app",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$swiftc"]
    }
  ]
}
